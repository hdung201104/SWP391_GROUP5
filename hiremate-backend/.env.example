# ==========================================
# HIREMATE AI BACKEND - ENVIRONMENT VARIABLES
# ==========================================

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/HireMateAI
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# Email SMTP Configuration (Gmail App Password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_gmail_address@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_google_app_password

# Gemini AI API Key (Optional for local testing if mocked)
GEMINI_API_KEY=your_gemini_api_key
