# ==============================================================================
# HIREMATE AI - BACKEND ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Hướng dẫn: Đổi tên hoặc sao chép file này thành .env trong thư mục hiremate-backend
# LƯU Ý: Không bao giờ commit file .env chứa Secret Key thật lên Git!
# ==============================================================================

# 1. Database Supabase PostgreSQL Cloud (IPv4 Pooler Transaction Mode 6543)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.orkdazjoorfdwlfbrmxf
SPRING_DATASOURCE_PASSWORD=Hoangdung1122

# 2. Email SMTP (Gửi OTP xác thực đăng ký / quên mật khẩu qua Gmail)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# 3. Gemini AI API Key (Dùng cho ATS CV Parser, Match Job & Mock Interview AI)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 4. Cloudinary (Lưu trữ tệp PDF CV, ảnh đại diện, file âm thanh phỏng vấn)
# Lấy tại: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=mezrtcb7
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

